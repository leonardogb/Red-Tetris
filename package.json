{
	"name": "red_tetris",
	"version": "0.0.1",
	"author": "lgarcia-",
	"license": "MIT",
	"scripts": {
		"eslint": "eslint src",
		"client-dist": "NODE_ENV=production webpack --progress --colors",
		"client-dev": "webpack-dev-server --colors --hot --inline --host 0.0.0.0 --port 7070",
		"srv-dev": "DEBUG=tetris:* babel-watch -w src src/server/main.js",
		"srv-dist": "DEBUG=tetris:* babel src --out-dir dist",
		"test": "mocha --require @babel/register --require ignore-styles --reporter spec --recursive --exit",
		"coverage": "NODE_ENV=test nyc --include src --all -r text -r lcov -r text --require @babel/register mocha --require ignore-styles --recursive --exit",
		"start": "DEBUG=tetris:* node dist/server/main.js"
	},
	"dependencies": {
		"@babel/plugin-transform-runtime": "^7.24.3",
		"@babel/runtime": "^7.24.1",
		"chai-http": "^4.4.0",
		"chai-spies": "^1.1.0",
		"debug": "^4.3.4",
		"jest": "^29.7.0",
		"react": "^18.2.0",
		"react-awesome-spinners": "^1.3.1",
		"react-dom": "^18.2.0",
		"react-redux": "^9.1.0",
		"react-router-dom": "^6.22.3",
		"redux": "^5.0.1",
		"redux-logger": "^3.0.6",
		"redux-saga": "^1.3.0",
		"redux-thunk": "^3.1.0",
		"socket.io": "^4.7.5",
		"socket.io-client": "^4.7.5",
		"styled-components": "^6.1.8",
		"webpack-cli": "^5.1.4"
	},
